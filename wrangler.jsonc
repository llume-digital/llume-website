{
  "name": "llume-website",
  "compatibility_date": "2026-09-01",
  // Vista previa de cada rama/PR en Workers Builds (`npx wrangler preview`). Hereda la config salvo las variables y
  // los bindings, que no se heredan: las que haga falta en las vistas previas se repiten aquí.
  "previews": {
    "vars": {
      // Misma clave que en producción para probar la demo privada de Nar&Co en la vista previa
      "NARANCO_CLAVE_SHA256": "aa214ce3978168d4428912e5e8daeb0bb993b686fee644ee3a33fb21913bc81f",
      // Ídem para el prototipo privado del panel de BioAsturias
      "BIOASTURIAS_CLAVE_SHA256": "49d7e1890e3ffa94d4ce4500b885a566448b3bc32cf78920262f25d36ff6dc54"
    }
  },
  // Solo atiende las rutas de assets.run_worker_first; el resto lo sirve Cloudflare directamente desde public/
  "main": "src/worker.js",
  // Solo se publica public/; los .md de la raíz quedan fuera de la web
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Rutas inexistentes muestran public/404.html con estado 404
    "not_found_handling": "404-page",
    "run_worker_first": ["/lopita/horarios/nube/*", "/naranco", "/naranco/*", "/bioasturias", "/bioasturias/*", "/admin", "/admin/*"]
  },
  // Base de datos compartida de la app de horarios de Lopita (ver src/worker.js)
  "durable_objects": {
    "bindings": [{ "name": "LOPITA_DATOS", "class_name": "LopitaDatos" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LopitaDatos"] }],
  // Base de datos del panel /admin (Cerebro). Esquema en migrations/. La clave del panel NO va aquí: es el secreto
  // ADMIN_CLAVE (`npx wrangler secret put ADMIN_CLAVE`; en local, en .dev.vars). Sin DB o sin clave, /admin responde 503.
  // Cada migración nueva de migrations/ se aplica a mano ANTES de subir el código que la usa:
  // `npx wrangler d1 migrations apply llume-cerebro --remote`.
  "d1_databases": [{ "binding": "DB", "database_name": "llume-cerebro", "database_id": "e4b4a46d-a04f-4ffe-9bb7-46302ea2af24", "migrations_dir": "migrations" }],
  "vars": {
    // sha256 de la clave de acceso a los datos de Lopita (la clave no está en el repo)
    "LOPITA_CLAVE_SHA256": "6ee72bf395616d1c96c79e8a64811a73c3bec78b9dde0389db5b8e618cb9bb8d",
    // Canal de Slack donde la app de horarios anuncia cada horario publicado. El token del bot NO va aquí: es un
    // secreto (`npx wrangler secret put SLACK_BOT_TOKEN`); mientras no exista, la app trabaja en modo simulación.
    "SLACK_CHANNEL": "#horarios",
    // sha256 de la clave de la demo privada de Nar&Co en /naranco/ (la clave no está en el repo, ver src/worker.js)
    "NARANCO_CLAVE_SHA256": "aa214ce3978168d4428912e5e8daeb0bb993b686fee644ee3a33fb21913bc81f",
    // sha256 de la clave del prototipo privado del panel de BioAsturias en /bioasturias/ (la clave no está en el repo)
    "BIOASTURIAS_CLAVE_SHA256": "49d7e1890e3ffa94d4ce4500b885a566448b3bc32cf78920262f25d36ff6dc54"
  }
}
