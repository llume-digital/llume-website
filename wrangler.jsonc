{
  "name": "llume-website",
  "compatibility_date": "2026-09-01",
  // Vista previa de cada rama/PR en Workers Builds (`npx wrangler preview`); vacío usa la misma config
  "previews": {},
  // Solo se publica public/; los .md de la raíz quedan fuera de la web
  "assets": {
    "directory": "./public",
    // Rutas inexistentes muestran public/404.html con estado 404
    "not_found_handling": "404-page"
  }
}
