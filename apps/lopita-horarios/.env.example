# Copia este archivo como .env y rellénalo.

# Primer usuario (solo se crea si aún no hay ninguno). Después se gestionan desde Ajustes.
LOPITA_ADMIN_USER=admin
LOPITA_ADMIN_PASSWORD=cambia-esta-contraseña

# Clave para firmar las sesiones (obligatoria con LOPITA_HTTPS=1): una cadena larga y aleatoria (p. ej. `python -c "import secrets;print(secrets.token_hex(32))"`).
LOPITA_SECRET=

# Dominio que apunta a esta máquina: Caddy pide el certificado HTTPS para él (docker-compose.yml)
LOPITA_DOMINIO=horarios.lopita.es

# Solo para la demo privada (docker-compose.demo.yml): dirección de la web nueva de Lopita, con contraseña
LOPITA_WEB_DOMINIO=lopita.demo.ejemplo.com

# Dirección pública de la app (se usa en los enlaces que llegan por Slack y en los calendarios /cal/<token>.ics)
LOPITA_PUBLIC_URL=https://horarios.lopita.es
# Pon 1 cuando se sirva por HTTPS (cookies seguras)
LOPITA_HTTPS=1

# Datos iniciales la primera vez: "ejemplo" (plantilla inventada) o "vacio"
LOPITA_SEED=vacio

# Segundos máximos que el motor dedica a cada horario
LOPITA_SOLVER_SEGUNDOS=30

# Slack (ver slack-manifest.yml). Sin token, la app funciona en modo simulación.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#horarios

# Pon 1 para publicar la documentación interactiva de la API en /api/docs (por defecto no se publica)
LOPITA_DOCS=0

# Pon 1 para que los enlaces /ver/<token> del horario se vean sin entrar en la app (por defecto piden sesión)
LOPITA_VISTA_PUBLICA=0

# Variante Cloudflare (docker-compose.cloudflare.yml + web en Cloudflare Pages), ver deploy/demo/README.md
# Token del túnel (Zero Trust → Networks → Tunnels) y secreto compartido con la función de Pages de la web
CLOUDFLARE_TUNNEL_TOKEN=
LOPITA_PROXY_SECRETO=
