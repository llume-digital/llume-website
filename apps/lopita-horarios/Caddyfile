# HTTPS automático (Let's Encrypt) para el dominio de LOPITA_DOMINIO, comprimido y con cabeceras de seguridad.
{$LOPITA_DOMINIO:localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}
	reverse_proxy lopita:8000
}
